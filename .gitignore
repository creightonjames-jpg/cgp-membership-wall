# Confidential, never commit. The repo is public and the Firebase rules are
# open by design, so anything tracked here is world readable at a guessable
# URL. Award and tenure winners get typed in from the admin panel at the show.
confidential/

# macOS
.DS_Store

# Raw headshot drops. Only the processed 400x400 versions get committed.
incoming/headshots/*
!incoming/headshots/README.md

# Cloud Functions. Dependencies are installed fresh on deploy, never committed.
# Secrets (the Resend API key) live in Firebase Secret Manager, never in a file.
functions/node_modules/
functions/.env
functions/.env.*
